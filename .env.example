# eBay developer app keyset (https://developer.ebay.com/my/keys). Production keys for real data.
EBAY_CLIENT_ID=your-ebay-app-id
EBAY_CLIENT_SECRET=your-ebay-cert-id
# production | sandbox
EBAY_ENV=production
EBAY_MARKETPLACE_ID=EBAY_US
# Set to 1 only if eBay has granted your app Marketplace Insights (sold data) access.
EBAY_USE_MARKETPLACE_INSIGHTS=0

# LLM providers (Anthropic is the default when its key is set)
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Optional Airtable export (personal access token with data.records:write)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Comps
